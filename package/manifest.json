{
    "manifest_version": 3,
    "name": "GitHub Changes",
    "description": "Makes viewing file changes a little easier.",
    "version": "0.5.1",
    "action": {
        "default_title": "View PR changes better",
        "default_popup": "popup.html",
        "default_icon": {
            "16": "images/compare-16.png",
            "32": "images/compare-32.png",
            "48": "images/compare-48.png",
            "128": "images/compare-128.png"
        }
    },
    "icons": {
        "16": "images/compare-16.png",
        "32": "images/compare-32.png",
        "48": "images/compare-48.png",
        "128": "images/compare-128.png"
    },
    "permissions": [
        "activeTab",
        "scripting",
        "tabs"
    ]
}